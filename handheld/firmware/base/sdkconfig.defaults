# Any ESP32-S3-DevKitC-1 (N8 or N16R8). 4 MB is the smallest flash fitted;
# the app uses no PSRAM.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
# Protocol lines own the native USB port (USB-Serial-JTAG driver in main.c).
# The console, and with it ESP_LOG and panic output, goes to UART0 only: the
# DevKitC's "UART" USB connector. Nothing but the ROM boot banner reaches the
# protocol port, and the host ignores lines not starting with "thermite ".
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
# Listening all the time: no modem sleep, no Wi-Fi NVS writes.
# CONFIG_ESP_WIFI_NVS_ENABLED is not set
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_PANIC=y
