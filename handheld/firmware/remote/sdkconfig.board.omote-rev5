# OMOTE Rev5: ESP32-S3-WROOM-1-N16R8 (16 MB flash, 8 MB octal PSRAM, unused).
# GPIO19/20 carry I2C, not USB: the console is UART0 behind the CH340C, and the
# USB-Serial-JTAG peripheral is off so it never claims those pins.
CONFIG_THERMITE_BOARD_OMOTE_REV5=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# CONFIG_USJ_ENABLE_USB_SERIAL_JTAG is not set
