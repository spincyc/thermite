# SPDX-License-Identifier: Apache-2.0
# Derived from the containers/common v0.57.4 default AppArmor template:
# https://github.com/containers/common/blob/v0.57.4/pkg/apparmor/apparmor_linux_template.go
# License: thermite-node-exporter.apparmor.LICENSE, distributed with this file.
#
# Modified for Thermite: retain default container confinement, allow shutdown
# signals from the selected OCI runtime/Podman, and grant only the system-bus
# calls used by node_exporter v1.12.1's systemd collector. UID/GID, capability
# dropping, no-new-privileges and read-only host mounts remain OCI settings.
# https://github.com/prometheus/node_exporter/blob/v1.12.1/collector/systemd_linux.go
#include <tunables/global>

profile thermite-node-exporter flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  umount,

  signal (receive) peer=unconfined,
  signal (send,receive) peer=thermite-node-exporter,
  signal (receive) peer={/usr/bin/,/usr/sbin/,}runc,
  signal (receive) set=(term,kill) peer={/usr/bin/,/usr/sbin/,}podman,
  ptrace (trace,read) peer=thermite-node-exporter,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny mount,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # go-systemd establishes two authenticated bus connections and registers
  # its JobRemoved listener. Do not include abstractions/dbus-strict: it also
  # grants StartServiceByName, which this exporter does not need.
  dbus (send)
       bus=system
       path=/org/freedesktop/DBus
       interface=org.freedesktop.DBus
       member={Hello,AddMatch}
       peer=(name=org.freedesktop.DBus),

  # Godbus handles the lifecycle signals for its own unique connection names.
  dbus (receive)
       bus=system
       path=/org/freedesktop/DBus
       interface=org.freedesktop.DBus
       member={NameAcquired,NameLost}
       peer=(name=org.freedesktop.DBus),

  dbus (receive)
       bus=system
       path=/org/freedesktop/systemd1
       interface=org.freedesktop.systemd1.Manager
       member=JobRemoved
       peer=(name=org.freedesktop.systemd1),

  # ListUnits is followed by the exporter's local unit-include regex filter.
  dbus (send)
       bus=system
       path=/org/freedesktop/systemd1
       interface=org.freedesktop.systemd1.Manager
       member=ListUnits
       peer=(name=org.freedesktop.systemd1),

  # Get is read-only. AppArmor cannot filter the property/interface arguments
  # in message bodies; these rules therefore allow Get on these systemd paths.
  dbus (send)
       bus=system
       path=/org/freedesktop/systemd1
       interface=org.freedesktop.DBus.Properties
       member=Get
       peer=(name=org.freedesktop.systemd1),
  dbus (send)
       bus=system
       path=/org/freedesktop/systemd1/unit/*
       interface=org.freedesktop.DBus.Properties
       member=Get
       peer=(name=org.freedesktop.systemd1),

  # Requested replies are implicit in dbus-daemon's AppArmor checks. No broad
  # receive, bind, eavesdrop, Properties.Set or systemd control methods.
}
