#!/usr/bin/env python3
"""thermite's one launcher; `thermite --help` lists its verbs."""

import os
import sys
from pathlib import Path
sys.dont_write_bytecode = True
sys.pycache_prefix = str(Path(__file__).resolve().parent / (".uncached-" + os.urandom(16).hex()))
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
import oh_paths  # noqa: E402
try:
    arguments = oh_paths.select_args(sys.argv[1:])
except oh_paths.SiteError as exc:
    sys.stderr.write(f"thermite: {exc}\n")
    raise SystemExit(2)

from oh_cli import run  # noqa: E402

sys.exit(run(Path(__file__).name, arguments))
